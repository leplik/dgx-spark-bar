# dgx-spark-bar agent configuration — /etc/dgx-spark-bar/agent.conf
# install.sh writes this file once and never overwrites it, so local edits
# survive an upgrade.

# Where the agent listens. 0.0.0.0 is intentional: it must be reachable both
# over the tailnet and over a plain LAN at a demo.
#
# There is no authentication. Anyone who can reach this port can read the
# status and reboot or power the box off — so keep the agent on networks you
# trust. If you need it on an untrusted one, set BIND to the tailnet address
# (100.x.y.z) instead of inventing a password.
BIND=0.0.0.0
PORT=8765

# Mount points to report, comma-separated.
DISKS=/

# Thresholds that turn the menu-bar dot yellow, and red.
WARN_DISK_PCT=85
WARN_GPU_TEMP=85
CRIT_GPU_TEMP=90

# Drop-in actions (plugins): every executable file in PLUGINS_DIR becomes a
# button in every connected client. The filename is the action name,
# `# desc:` in the file's first lines is its caption, `# confirm: yes` asks
# the client to confirm first. Output goes to PLUGINS_LOG_DIR/<name>.log
# (served back at GET /plugin-log?name=X). Keep the dir writable by root only:
# a plugin is code the agent will run, and the agent refuses group- or
# world-writable files.
PLUGINS_DIR=/etc/dgx-spark-bar/plugins
PLUGINS_LOG_DIR=/var/lib/dgx-spark-bar/plugin-logs

# Drop-in links: web UIs this box serves. One file per link, e.g.
#   NAME=Open Zolli
#   PORT=3200
#   URL_PATH=/
#   DESC=Customer cabinet
# No host: the client fills in the address it already reaches the agent on, so
# one file works over the tailnet and the LAN alike — and a link cannot point
# off this box. These files are data and are never executed.
LINKS_DIR=/etc/dgx-spark-bar/links
