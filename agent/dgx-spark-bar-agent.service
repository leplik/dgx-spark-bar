[Unit]
Description=dgx-spark-bar agent — DGX Spark monitoring and power control
Documentation=https://github.com/leplik/dgx-spark-bar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
ExecStart=/usr/local/bin/dgx-spark-bar-agent
Restart=always
RestartSec=3
# The agent shells out to sudo for poweroff/reboot, so privilege escalation
# must stay possible; the sudoers drop-in narrows it to exactly those two.
NoNewPrivileges=no
PrivateTmp=yes
# "read-only" and not "yes": DISKS often lists /home, and "yes" would replace it
# with an empty tmpfs whose free space is not the number anyone wants to see.
ProtectHome=read-only
# "full" and not "strict": sudo keeps its timestamp files under /run, which
# strict would remount read-only.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
